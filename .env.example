# ── 幾分 環境變數範本 ──
# 本機開發：複製成 .env.local；Docker 部署：複製成 .env.production
# cp .env.example .env.production

# next-auth 加密金鑰（必填）。產生方式： openssl rand -base64 32
AUTH_SECRET=

# 正式網址（正式部署必填 https，供 OAuth 回呼）。例： https://jifen.space
AUTH_URL=

# 對外公開網址，供 SEO（sitemap / robots / OG 分享圖 / canonical）使用。
# 未設定時預設 https://jifen.space；換網域時改這裡即可。
NEXT_PUBLIC_SITE_URL=https://jifen.space

# Google OAuth（從 https://console.cloud.google.com 取得）
# 回呼網址設定為： <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 揭曉排程的外部觸發密鑰（選填）。
# 內建 node-cron 會自動於每晚 21:00 揭曉，不需此值；
# 若要用外部排程器呼叫 /api/cron/reveal 才需要設定。
CRON_SECRET=

# Gemini 圖片審核（選填）。留空時開發環境會略過審核直接通過。
GEMINI_API_KEY=

# Cloudflare Tunnel token（Zero Trust → Networks → Tunnels 建立後取得）。
# 設定後 VM 不需開放任何對外端口，網域經 Cloudflare 安全導向到 app。
TUNNEL_TOKEN=

# ── 以下在 Docker 中已有預設值，通常不需更改 ──
# SQLite 位置與上傳目錄
DATABASE_URL=file:/app/data/jifen.db
DATA_DIR=/app/data
# 排程時區
TZ=Asia/Taipei
